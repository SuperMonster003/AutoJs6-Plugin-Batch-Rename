<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="org.autojs.permission.PLUGIN" />

    <!-- The host settings provider (theme color, night mode, language) of AutoJs6 (roadmap D24). -->
    <queries>
        <package android:name="org.autojs.autojs6" />
    </queries>

    <!-- No launcher entry and no storage permission: the host renames files on the plugin's behalf (roadmap D3 / D4). -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:label="@string/app_name"
        android:enableOnBackInvokedCallback="true"
        android:supportsRtl="true"
        android:icon="@mipmap/ic_icon_studio_application"
        android:roundIcon="@mipmap/ic_icon_studio_application">

        <!-- Compose ui-graphics packages libandroidx.graphics.path.so, stored uncompressed and 16 KB aligned (roadmap D28). -->
        <meta-data
            android:name="org.autojs.plugin.contract.NATIVE_PAGE_ALIGNMENT"
            android:value="16384" />

        <meta-data
            android:name="org.autojs.plugin.WAKE_ACTIVITY"
            android:value=".WakeActivity" />

        <meta-data
            android:name="org.autojs.plugin.info.AUTHOR"
            android:value="@string/plugin_author" />

        <activity
            android:name=".WakeActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:finishOnTaskLaunch="true"
            android:permission="org.autojs.permission.PLUGIN"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <category android:name="android.intent.category.DEFAULT" />
                <action android:name="org.autojs.plugin.action.WAKE" />
            </intent-filter>
        </activity>

        <!--
            File manager entry (roadmap D10 / D23): the host starts the rename screen for the three catalog actions.
            Every catalog activity needs the EXECUTE + DEFAULT filter, or the host silently drops its actions.
        -->
        <activity
            android:name=".BatchRenameActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:permission="org.autojs.permission.PLUGIN"
            android:theme="@style/Theme.BatchRename"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="org.autojs.plugin.EXPLORER_ACTION_EXECUTE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Plugin Center identity (engine batch-rename). -->
        <service
            android:name=".BatchRenamePluginInfoService"
            android:exported="true"
            android:permission="org.autojs.permission.PLUGIN">
            <meta-data
                android:name="requiresHostVersion"
                android:value="@string/plugin_requires_host_version" />
            <intent-filter>
                <action android:name="org.autojs.plugin.INFO" />
                <category android:name="batch-rename" />
            </intent-filter>
        </service>

        <!-- Script API capability (roadmap D13 / D14); placeholder Binder until roadmap P1.1 / P4.1. -->
        <service
            android:name=".BatchRenamePluginService"
            android:exported="true"
            android:permission="org.autojs.permission.PLUGIN">
            <meta-data
                android:name="requiresHostVersion"
                android:value="@string/plugin_requires_host_version" />
            <intent-filter>
                <action android:name="org.autojs.plugin.BATCH_RENAME" />
                <category android:name="batch-rename" />
            </intent-filter>
        </service>

        <!--
            Explorer Action discovery (roadmap D22 / D23): identity with engine explorer-action and the action
            catalog. The host's Explorer Action registry reads the build requirement from getInfo().capabilities.
        -->
        <service
            android:name=".BatchRenameExplorerActionService"
            android:exported="true"
            android:permission="org.autojs.permission.PLUGIN">
            <intent-filter>
                <action android:name="org.autojs.plugin.EXPLORER_ACTION" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

    </application>

</manifest>
