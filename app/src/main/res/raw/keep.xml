<?xml version="1.0" encoding="utf-8"?>
<!--
    The host reads these resources by name across packages, so release resource shrinking must keep them: the Plugin
    Center instruction (PluginInfo.instruction = "@raw/plugin_instruction") and the labels of the Explorer Action
    catalog (labelResourceName of BatchRenameCatalog).
-->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@raw/plugin_instruction,@string/explorer_action_rename_selection,@string/explorer_action_rename_inside,@string/explorer_action_rename_single" />
